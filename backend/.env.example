NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_appointments
# Use a long random value (e.g. `openssl rand -hex 32`). Placeholder values are rejected in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:3000
# Clinic timezone as minutes offset from UTC (Pakistan = 300). Used for "past slot" checks.
TZ_OFFSET_MINUTES=300

# Patients may cancel confirmed appointments only this many hours before they start
CANCELLATION_WINDOW_HOURS=2

# Seed script only (npm run seed). Required in production.
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=admin@clinic.example
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DOCTOR_PASSWORD=Doctor@12345
# Seed only: create the 6 sample doctors? Defaults to true in development, false in production.
SEED_SAMPLE_DOCTORS=true
