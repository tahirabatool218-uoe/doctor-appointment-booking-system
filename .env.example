# Reference only. Real files: backend/.env (copy backend/.env.example) and frontend/.env.local (copy frontend/.env.example).
# `npm run setup` creates both for you.

# ---- backend/.env ----
NODE_ENV=development                 # production on the server
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_appointments
JWT_SECRET=change-me-to-a-long-random-string   # prod: >=32 random chars (openssl rand -hex 32); placeholder is rejected
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000     # exact browser origin(s), comma-separated, no trailing slash
TZ_OFFSET_MINUTES=300                # clinic UTC offset in minutes (Pakistan = 300)
CANCELLATION_WINDOW_HOURS=2
# seed only
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=admin@clinic.example
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DOCTOR_PASSWORD=Doctor@12345
SEED_SAMPLE_DOCTORS=true             # default true in dev, false in production

# ---- frontend/.env.local (inlined at build time) ----
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_USE_MOCK=false     # true = in-browser mock API fallback
